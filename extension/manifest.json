{
  "manifest_version": 3,
  "name": "SafetyLayer: Google Maps Route-Safety Intelligence",
  "version": "1.0.0",
  "description": "SafetyLayer (formerly SafeLayer): Crowdsourced route-safety and hazard layer on top of Google Maps powered by Gemma 4 multimodal AI.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["*://*.google.com/maps/*", "*://maps.google.com/*", "http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafetyLayer Route Safety"
  },
  "content_scripts": [
    {
      "matches": ["*://*.google.com/maps/*", "*://maps.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
