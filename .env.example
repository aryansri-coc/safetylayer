# Google Maps API Key (Optional: App falls back to MapLibre + OpenStreetMap if not provided)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Gemma 4 Provider: "mock" (offline/zero-dependency), "hosted" (Google AI Studio / Vertex), or "ollama" (local)
GEMMA_PROVIDER=mock
GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-4-12b-it
GEMMA_OLLAMA_URL=http://localhost:11434

# Database Mode: "sqlite" (local zero-config with geohashing) or "supabase" (PostGIS)
DATABASE_MODE=sqlite
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo Configuration
NEXT_PUBLIC_DEMO_DEFAULT_CORRIDOR=delhi_cp
NEXT_PUBLIC_MAP_DEFAULT_LAT=28.6315
NEXT_PUBLIC_MAP_DEFAULT_LNG=77.2167
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=15
